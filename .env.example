# 네이버메일 IMAP 연동용 자격 증명
# 1) 이 파일을 복사해서 .env 로 저장하세요 (.env는 git에 올라가지 않습니다)
# 2) 아래 값을 직접 채워 넣으세요 (채팅창에는 붙여넣지 마세요)

# 네이버 아이디 (예: taesanrec333, @naver.com 제외)
NAVER_MAIL_ID=

# 2단계 인증을 켠 경우: 네이버 계정관리 > 보안설정 > 애플리케이션 비밀번호에서 발급받은 값
# 2단계 인증을 안 켠 경우: 네이버 로그인 비밀번호
NAVER_MAIL_APP_PASSWORD=

# IMAP 서버 정보 (기본값 그대로 두면 됩니다)
NAVER_IMAP_HOST=imap.naver.com
NAVER_IMAP_PORT=993
